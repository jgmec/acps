# Copy to .env (cp .env.example .env). Both wtfps and `docker compose` read it.

# Database started with `docker compose up -d --wait`. These only take effect when the
# volume is first created; changing the password later needs ALTER USER in psql.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=test
POSTGRES_DB=wtfps
WTFPS_DB_PORT=55432

# Port of the HTTP API (`docker compose up -d api`), on all network interfaces
WTFPS_API_PORT=8090

# How wtfps (and SQLx, when compiling) connects; built from the values above
DATABASE_URL=postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@127.0.0.1:${WTFPS_DB_PORT}/${POSTGRES_DB}

# For a Postgres installed locally instead of Docker, over its Unix socket:
#DATABASE_URL=postgres:///wtfps

# Folder of elevation tiles for --terrain / ?terrain=true (downloaded on first use)
#WTFPS_DEM_DIR=dem

# Compile without a running database, using the saved query data in .sqlx/ (editors
# such as Zed check the code in the background; without this, the WiFi queries show as
# errors whenever the database is down). Regenerate it with `cargo sqlx prepare` after
# changing a `query!` macro.
SQLX_OFFLINE=true

# Hide the harmless "extension postgis already exists" notice
#RUST_LOG=info,sqlx::postgres::notice=warn
